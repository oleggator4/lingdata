    <TIER ANNOTATOR="@amk2008f" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="gesture_organs"
        PARENT_REF="gestType@amk2008f" PARTICIPANT="@amk2008f" TIER_ID="geastLegs@amk2008f"/>
    <TIER ANNOTATOR="@amk2008f" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="gesture_comment"
        PARENT_REF="gestType@amk2008f" PARTICIPANT="@amk2008f" TIER_ID="gestComment@amk2008f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a873" ANNOTATION_REF="a857">
                <ANNOTATION_VALUE>тут параллельно и пальцы и поворот головы, выбралаголову, так как она заметнее и важнее для собеседника</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a890" ANNOTATION_REF="a886">
                <ANNOTATION_VALUE>рука не в раслабленном положении, крутит кольцо на пальце</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a910" ANNOTATION_REF="a904">
                <ANNOTATION_VALUE>легкий кивок головы, параллельно жест пальцами</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a899" ANNOTATION_REF="a893">
                <ANNOTATION_VALUE>интерес,так как задаю следующий вопрос, интерес в проолженни диалога</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a942" ANNOTATION_REF="a912">
                <ANNOTATION_VALUE>параллельно жест пальцами</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a932" ANNOTATION_REF="a903">
                <ANNOTATION_VALUE>параллельно жест пальцами</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER ANNOTATOR="@amk2008f" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="gesture_comment"
        PARENT_REF="gestType@vie2008f" PARTICIPANT="@vie2008f" TIER_ID="gestComment@vie2008f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a885" ANNOTATION_REF="a882">
                <ANNOTATION_VALUE>легкое движение головы, чтобы посмотреть на телефон</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a878" ANNOTATION_REF="a877">
                <ANNOTATION_VALUE>заметный выдох, облегечение после неожиданного вопроса, сомневалась, орган тело или плечи, но при выдохе важно движение груди, а плечи заметно опускаются </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a979" ANNOTATION_REF="a874">
                <ANNOTATION_VALUE>пожать плечами в знак неувереннсоти </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a949" ANNOTATION_REF="a945">
                <ANNOTATION_VALUE>движение головы вверх, уверенность в преимуществе фастфуда</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a951" ANNOTATION_REF="a948">
                <ANNOTATION_VALUE>покачивание головы из стороны в сторону в момент перечеслиния</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a956" ANNOTATION_REF="a953">
                <ANNOTATION_VALUE>отказ от варианта кбжу</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a960" ANNOTATION_REF="a954">
                <ANNOTATION_VALUE>интерес к собеседнику после своего ответа</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a963" ANNOTATION_REF="a961">
                <ANNOTATION_VALUE>перемещение рук в более удобную и расслабленную позу</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a966" ANNOTATION_REF="a964">
                <ANNOTATION_VALUE>поворот головы, чтобы не смотреть на собеседника и сконцентрироваться на формулировании ответа</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a972" ANNOTATION_REF="a969">
                <ANNOTATION_VALUE>тут я не поняла, может она просто почесала шею, но мне кажется, что из-за не очень расслабленной обстановки это может быть и проявление нервозности, но так как это произошло во время ответа на вопрос, я больше склоняюсь к задуматься, чтобы сформулировать ответ</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a976" ANNOTATION_REF="a974">
                <ANNOTATION_VALUE>тут мне кажется целый набор из мотания головы и поврота, отрицание в плане не пробую новое, интерес в мнении собеседника и возможно даже насмешка, но из-за отрицания в речи выбираю его</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a982" ANNOTATION_REF="a977">
                <ANNOTATION_VALUE>тяжело понять, движение в разные стороны на "одно и то же" как бы иллюстрирует схожесть заказанного или больше акцентирует внимание на фразе</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a989" ANNOTATION_REF="a984">
                <ANNOTATION_VALUE>акцент на НЕ ем, параллельное движение головой в подтверждение слов</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a996" ANNOTATION_REF="a990">
                <ANNOTATION_VALUE>легкое покачивание головы, может это прагматический жест, который подчеркивает, что это пример, но я отнесла к адаптору и пренебрежению, так как говорится про что-то нелюбимое и приводится один из многих возможных примеров, но это выбран не из-за особого негатива, а первое, что пришло в голову</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
