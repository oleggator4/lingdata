            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a493"
                TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts139">
